# Algo-fox — environment template.
# Copy to apps/web/.env (local dev) and set real values.
# NEVER commit real secrets. See packages/env/src/index.ts for the
# centrally validated subset; the rest is consumed by apps/web.

# --- Runtime ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Postgres / Prisma ---
DATABASE_URL=postgresql://user:password@localhost:5432/algofox
PRISMA_POOL_SIZE=5

# --- Redis (URL form preferred; host/port fallback; "DISABLED" to disable) ---
REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- Auth (Better-Auth) ---
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ADMIN_USER_IDS=
# Legacy fallback, prefer BETTER_AUTH_URL:
# NEXTAUTH_URL=http://localhost:3000

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Judge0 / worker pull-model ---
JUDGE0_URL=
WORKER_SECRET=change-me
APP_BASE_URL=http://localhost:3000

# --- S3 uploads ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-2
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_DOMAIN=

# --- Email (Resend preferred, SMTP fallback) ---
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Network / security ---
CLOUDFLARE_ENABLED=
BLOCKED_COUNTRIES=
DEBUG_SECURITY=
ENABLE_LIMIT_IN_DEV=
