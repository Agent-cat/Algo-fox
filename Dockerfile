# Algo-fox monorepo — web image (Next.js standalone).
# Build from the repo root:  docker build -f Dockerfile -t agentcat1/algofox .
# Or: docker compose up --build

# Stage 1: Pruner — minimal context for @algofox/web
FROM node:22-alpine AS pruner
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@10.34.5 turbo@2
COPY . .
RUN turbo prune @algofox/web --docker

# Stage 2: Installer
FROM node:22-alpine AS installer
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
RUN npm install -g pnpm@10.34.5
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --frozen-lockfile

# Stage 3: Builder
FROM node:22-alpine AS builder
RUN apk add --no-cache openssl
WORKDIR /app
RUN npm install -g pnpm@10.34.5
COPY --from=installer /app/ .
COPY --from=pruner /app/out/full/ .
# Dummy URL allows static generation at build time; real secrets at runtime.
ARG DATABASE_URL=""
ENV DATABASE_URL=${DATABASE_URL}
ENV BETTER_AUTH_URL=http://localhost:3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_CACHE_HANDLER=1
# Prisma client is generated by @algofox/db postinstall; ensure it here too.
RUN pnpm --filter @algofox/db db:generate
RUN pnpm --filter @algofox/web build

# Stage 4: Runner
FROM node:22-alpine AS runner
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# To disable Redis features, set REDIS_URL="DISABLED".
ENV REDIS_URL="DISABLED"

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

# Standalone server keeps the workspace layout: apps/web/server.js
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
