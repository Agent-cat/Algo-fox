# Algo-fox monorepo — worker host service (apps/api, Hono).
# Shares the pruned context with the web image via --target api.
# Build: docker build -f Dockerfile.api -t agentcat1/algofox-api .

# Stage 1: Pruner
FROM node:22-alpine AS pruner
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@10.34.5 turbo@2
COPY . .
RUN turbo prune algofox-api --docker

# Stage 2: Installer
FROM node:22-alpine AS installer
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
RUN npm install -g pnpm@10.34.5
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --frozen-lockfile --prod=false

# Stage 3: Runner (tsx, same as the repo's local `worker` script precedent)
FROM node:22-alpine AS runner
RUN apk add --no-cache openssl
WORKDIR /app
RUN npm install -g pnpm@10.34.5
ENV NODE_ENV=production
COPY --from=installer /app/ .
COPY --from=pruner /app/out/full/ .
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs
USER nextjs

EXPOSE 3001
ENV PORT=3001

# Required at runtime: DATABASE_URL, REDIS_URL, WORKER_SECRET
CMD ["pnpm", "--filter", "algofox-api", "start"]
